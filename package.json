    "@types/express": "^4.17.13",
    "@types/node": "^22.10.5",
    "nodemon": "^3.1.9",
    "prettier": "3.4.2",
    "ts-node": "^10.4.0",
    "tslint": "^6.1.3",
    "typescript": "^5.7.2"
